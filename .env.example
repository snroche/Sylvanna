# Copy to .env and fill in your own values. Never commit the real .env.

# --- Narrator (LLM) ---------------------------------------------------------
# Get a key at https://openrouter.ai/keys. If left empty the app boots fine and
# falls back to a deterministic "dummy" narrator — useful for dev and CI.
OPENROUTER_API_KEY=

# Comma-separated list: the first model is primary, the rest are fallbacks.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional cheaper model used only for rolling-summary calls.
# Defaults to OPENROUTER_MODEL when empty.
OPENROUTER_MODEL_SUMMARIZER=

# Messages accumulated before the chronicle summary is refreshed.
RESUMIR_CADA=60

# --- Database ---------------------------------------------------------------
# SQLite by default. For Postgres/Neon paste the connection string as-is:
# the app normalizes it to the asyncpg driver and strips sslmode.
DATABASE_URL=sqlite+aiosqlite:///./local.db

# --- Human DM panel ---------------------------------------------------------
# Empty disables the admin panel entirely. Set a long random secret to enable
# it, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
ADMIN_TOKEN=
